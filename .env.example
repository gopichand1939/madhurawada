# ==============================================================================
# BACKEND API URL (Matches Netlify variable NEXT_PUBLIC_API_BASE_URL)
# Easily switch between Local Backend (port 4000) and Production Render Backend
# ==============================================================================

# --- OPTION 1: Local Backend (Uncomment to use local backend) ---
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# BACKEND_ORIGIN=http://localhost:4000

# --- OPTION 2: Production Render Backend (Default) ---
NEXT_PUBLIC_API_BASE_URL=https://madhurawada-backend.onrender.com
BACKEND_ORIGIN=https://madhurawada-backend.onrender.com
VITE_API_BASE_URL=https://madhurawada-backend.onrender.com
